import pygame
import sys


class Button:
    def __init__(self, screen: pygame.Surface, x, y, play):
        self.screen = screen
        self.x = x
        self.y = y
        self.play_button = pygame.image.load("play.png")
        self.base_play_button = pygame.image.load("play.png")
        self.pause_button = pygame.image.load("play.png")
        self.pressed = False
    def draw(self):
        self.screen.blit(self.play_button, (0, 0))

    def toggle(self):
        self.pressed = not self.pressed
        # self.color = self.active_colour if self.pressed else self.base_color
        if self.pressed:
            self.play_button = self.pause_button
        else:
            self.play_button = self.base_play_button
        



def play_button_test():
    screen = pygame.display.set_mode((800, 500))
    play_button_test = Button(screen, 400, 400)
    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                sys.exit()

            if event.type == pygame.MOUSEBUTTONDOWN:
                mouse_pos = pygame.mouse.get_pos()
                distance = ((mouse_pos[0] - (play_button_test.x - 350)) ** 2 + (mouse_pos[1] - (play_button_test.y + 50)) ** 2) ** 0.5
                if distance <= 20:
                    play_button_test.toggle()
        play_button_test.draw()
        
        
        pygame.display.update()


if __name__ == "__main__":
    play_button_test()
